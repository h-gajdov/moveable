# Copy to .env and change the passwords. Never commit .env.
DB_NAME=accessible_skopje
DB_USER=accessible
DB_PASSWORD=change-me-db-password
DB_PORT=5433

# Bootstrap administrator (created on first start if no admin exists).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

BACKEND_PORT=8080
FRONTEND_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Map style (MapLibre style JSON). OpenFreeMap is free, open and has no API key;
# self-host tiles for production (see docs/DEPLOYMENT.md).
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Origins the frontend Content-Security-Policy allows for map styles/tiles/glyphs.
MAP_ORIGINS=https://tiles.openfreemap.org
